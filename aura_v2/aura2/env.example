# Copy to .env and fill in real values. Never commit the real .env.

# ---- LLM (OpenRouter) ----
OPENROUTER_API_KEY=
OPENROUTER_MODEL=moonshotai/kimi-k2.6:free
OPENROUTER_FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---- Tools ----
OPENWEATHER_API_KEY=
# Same Google Cloud project/key as YouTube works here — just also enable
# "Custom Search API" in that project's API Library, and create a search
# engine at https://programmablesearchengine.google.com/ to get the CX id.
GOOGLE_API_KEY=
GOOGLE_SEARCH_CX=

# ---- Database ----
# Port 5433, not the Postgres default 5432 — deliberately avoids colliding
# with any native PostgreSQL install already running on your machine.
POSTGRES_URI=postgresql://aura:aura@localhost:5433/aura

# ---- Redis (background ingestion jobs) ----
REDIS_URL=redis://localhost:6379/0

# ---- Auth ----
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ---- Google OAuth (Gmail, Calendar, Drive) — per-user tokens ----
GOOGLE_CREDENTIALS_PATH=secrets/google/credentials.json
GOOGLE_TOKEN_DIR=secrets/google/tokens

# ---- RAG ----
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIM=768
MAX_UPLOAD_MB=25
MAX_CONCURRENT_INGESTION_JOBS=2

# ---- Voice ----
WHISPER_MODEL_SIZE=small
VOICE_ENABLED=false

# ---- Observability ----
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=aura

# ---- Safety limits ----
MAX_MODEL_CALLS_PER_RUN=20
MAX_TOOL_CALLS_PER_RUN=20
RATE_LIMIT_RPM=30

# ---- Summarization ----
SUMMARIZATION_TRIGGER_MESSAGES=30
SUMMARIZATION_KEEP_MESSAGES=20

# ---- App ----
APP_ENV=development
LOG_LEVEL=INFO
